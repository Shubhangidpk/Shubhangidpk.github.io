    "CurrencyType": {
      "label": "string",
      "value": "string"
    },
    "FileType": {
      "FileName": "string",
      "FileRef": "any",
      "FileSize": "number",
      "FileType": "string"
    },
    "getall_Receipts": {
      "items": [
        {
          "accountType": "string",
          "amount": "string",
